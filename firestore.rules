rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(ownerUid) {
      return signedIn() && request.auth.uid == ownerUid;
    }

    function unchanged(field) {
      return resource == null || request.resource.data[field] == resource.data[field];
    }

    function isParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    function isMasterAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'master';
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Private profile data. Public seller info lives in /sellers/{uid}.
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      allow create: if isOwner(uid)
        // Prevent privilege escalation on account creation
        && !('role' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('isBanned' in request.resource.data)
        && !('isVerified' in request.resource.data);

      allow update: if isOwner(uid)
        // Users cannot elevate their own privileges
        && unchanged('role')
        && unchanged('isAdmin')
        && unchanged('isBanned')
        && unchanged('isVerified')
        && unchanged('isPremium')
        // Admins can update anything (role changes, bans, verification)
        || isAdmin();

      allow delete: if isAdmin();

      match /saved/{listingId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read, update: if isOwner(uid);
        allow create: if isAdmin(); // only system/admin sends notifications
        allow delete: if isOwner(uid);
      }
    }

    // ── Sellers (public profile) ──────────────────────────────────────────────
    // Public-facing seller info shown on shop pages — anyone can read.
    match /sellers/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && !('isVerified' in request.resource.data)
        && !('isBanned' in request.resource.data);

      allow update: if isAdmin()
        || (isOwner(uid)
            && unchanged('isVerified')
            && unchanged('isBanned')
            && unchanged('isPremium'));

      allow delete: if isAdmin();
    }

    // ── Listings ──────────────────────────────────────────────────────────────
    match /listings/{listingId} {
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || isOwner(resource.data.ownerUid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        // Prevent users crafting fake promoted/sponsored listings
        && request.resource.data.isSponsored == false
        && request.resource.data.isFlashSale == false
        && request.resource.data.isTrial == false;

      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            // Cannot change ownership or bypass moderation
            && unchanged('ownerUid')
            && unchanged('status')
            // Cannot self-grant promotions/sponsorships
            && unchanged('isSponsored')
            && unchanged('sponsoredUntil')
            && unchanged('isFlashSale')
            && unchanged('flashSaleEndsAt')
            && unchanged('isTrial'));

      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    // ── Happenings ────────────────────────────────────────────────────────────
    match /happenings/{happeningId} {
      allow read: if isAdmin()
        || resource.data.status == 'approved'
        || isOwner(resource.data.ownerUid);

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isSponsored == false;

      allow update: if isAdmin()
        || (signedIn()
            && resource.data.ownerUid == request.auth.uid
            && unchanged('ownerUid')
            && unchanged('status')
            && unchanged('isSponsored')
            && unchanged('sponsoredUntil'));

      allow delete: if isAdmin() || isOwner(resource.data.ownerUid);
    }

    // ── Promotion requests ────────────────────────────────────────────────────
    match /promotionRequests/{requestId} {
      allow read: if isAdmin() || isOwner(resource.data.uid);

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        || (signedIn()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.status in ['cancelled']);

      allow delete: if isMasterAdmin();
    }

    // ── Archived requests ─────────────────────────────────────────────────────
    match /archivedRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isMasterAdmin();
    }

    // ── Reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if signedIn()
        // Reporter must identify themselves honestly
        && request.resource.data.reporterUid == request.auth.uid
        // Prevent spam — one report per user per listing (enforce in app layer too)
        && request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if isMasterAdmin();
    }

    // ── Admins ────────────────────────────────────────────────────────────────
    match /admins/{uid} {
      allow read: if isAdmin();

      // FIXED: any signed-in user could previously create their own admin doc.
      // Now requires the user's email to be pre-approved OR a master admin creates it.
      allow create: if isMasterAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && exists(/databases/$(database)/documents/approved_admin_emails/$(request.auth.token.email)));

      allow update: if isMasterAdmin()
        || (signedIn() && request.auth.uid == uid
            // Admins cannot self-promote to master
            && unchanged('role')
            && unchanged('isActive'));

      allow delete: if isMasterAdmin();
    }

    // ── Approved admin emails ─────────────────────────────────────────────────
    match /approved_admin_emails/{emailId} {
      allow read: if isMasterAdmin();
      allow create, update, delete: if isMasterAdmin();
    }

    // ── Admin settings ────────────────────────────────────────────────────────
    // Contains app-wide config (maintenance mode, feature flags, etc.)
    match /admin_settings/{docId} {
      allow read: if true; // maintenance banners etc. need public read
      allow create, update, delete: if isMasterAdmin();
    }

    // ── Admin notifications ───────────────────────────────────────────────────
    // FIXED: was `signedIn()` — any logged-in user could read admin notifications.
    match /admin_notifications/{docId} {
      allow read: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // ── Chats ─────────────────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isParticipant();

      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.listingId is string;

      allow update: if isParticipant()
        // Participants list is immutable after creation
        && request.resource.data.participants == resource.data.participants;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant();

        allow create: if isParticipant()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          // Prevent empty messages and cap at 5000 chars
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update, delete: if false; // messages are immutable
      }
    }

    // ── Support chats (user ↔ admin) ──────────────────────────────────────────
    match /supportChats/{chatUid} {
      allow read: if isOwner(chatUid) || isAdmin();
      allow create: if isOwner(chatUid);
      allow update: if isOwner(chatUid) || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(chatUid) || isAdmin();

        allow create: if (isOwner(chatUid) || isAdmin())
          // Sender must honestly identify themselves
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ── Support messages (standalone) ─────────────────────────────────────────
    match /supportMessages/{messageId} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update: if isAdmin();
      allow delete: if isMasterAdmin();
    }

    // ── Admin logs ────────────────────────────────────────────────────────────
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if isMasterAdmin();
    }

    // ── Deny everything not explicitly matched ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
